{"zabbix_export": {"version": "7.4", "media_types": [{"name": "Post to API", "type": "WEBHOOK", "parameters": [{"name": "API_KEY", "value": "<YOUR_API_KEY_HERE>"}, {"name": "Message", "value": "{ALERT.MESSAGE}"}, {"name": "Subject", "value": "{ALERT.SUBJECT}"}, {"name": "To", "value": "{ALERT.SENDTO}"}, {"name": "URL", "value": "<YOUR_API_URL_HERE>"}], "script": "try {\n    var params = JSON.parse(value);\n\n    var url = params.URL;\n    var to = params.To;\n    var subject = params.Subject;\n    var message = params.Message;\n    var apiKey = params.API_KEY;\n\n    var req = new HttpRequest();\n\n    req.addHeader('Content-Type: application/json');\n    req.addHeader('X-API-Key: ' + apiKey);\n\n    var payload = {\n        \"to\": to,\n        \"subject\": subject,\n        \"message\": message\n    };\n\n    var response = req.post(url, JSON.stringify(payload));\n\n    if (req.getStatus() != 200) {\n        throw 'HTTP error ' + req.getStatus() + ': ' + response;\n    }\n\n    return 'Message sent successfully';\n}\ncatch (error) {\n    Zabbix.log(3, 'custom_webhook error: ' + error);\n    throw 'custom_webhook failed: ' + error;\n}", "message_templates": [{"event_source": "TRIGGERS", "operation_mode": "PROBLEM", "subject": "Problem: {EVENT.NAME}", "message": "{\"type\":\"problem\",\"event\":{\"id\":\"{EVENT.ID}\",\"name\":\"{EVENT.NAME}\",\"time\":\"{EVENT.TIME}\",\"date\":\"{EVENT.DATE}\",\"severity\":\"{EVENT.SEVERITY}\",\"opdata\":\"{EVENT.OPDATA}\"},\"host\":{\"name\":\"{HOST.NAME}\"},\"trigger\":{\"url\":\"{TRIGGER.URL}\"}}"}, {"event_source": "TRIGGERS", "operation_mode": "RECOVERY", "subject": "Resolved in {EVENT.DURATION}: {EVENT.NAME}", "message": "{\"type\":\"problem_recovery\",\"event\":{\"id\":\"{EVENT.ID}\",\"name\":\"{EVENT.NAME}\",\"severity\":\"{EVENT.SEVERITY}\",\"duration\":\"{EVENT.DURATION}\",\"recovery\":{\"time\":\"{EVENT.RECOVERY.TIME}\",\"date\":\"{EVENT.RECOVERY.DATE}\"}},\"host\":{\"name\":\"{HOST.NAME}\"},\"trigger\":{\"url\":\"{TRIGGER.URL}\"}}"}, {"event_source": "TRIGGERS", "operation_mode": "UPDATE", "subject": "Updated problem in {EVENT.AGE}: {EVENT.NAME}", "message": "{\"type\":\"problem_update\",\"user\":{\"fullname\":\"{USER.FULLNAME}\"},\"event\":{\"id\":\"{EVENT.ID}\",\"name\":\"{EVENT.NAME}\",\"status\":\"{EVENT.STATUS}\",\"age\":\"{EVENT.AGE}\",\"ack\":{\"status\":\"{EVENT.ACK.STATUS}\"},\"update\":{\"action\":\"{EVENT.UPDATE.ACTION}\",\"date\":\"{EVENT.UPDATE.DATE}\",\"time\":\"{EVENT.UPDATE.TIME}\",\"message\":\"{EVENT.UPDATE.MESSAGE}\"}}}"}, {"event_source": "SERVICE", "operation_mode": "PROBLEM", "subject": "Service \"{SERVICE.NAME}\" problem: {EVENT.NAME}", "message": "{\"type\":\"service\",\"event\":{\"id\":\"{EVENT.ID}\",\"name\":\"{EVENT.NAME}\",\"date\":\"{EVENT.DATE}\",\"time\":\"{EVENT.TIME}\",\"severity\":\"{EVENT.SEVERITY}\",\"recovery\":{\"time\":\"{EVENT.RECOVERY.TIME}\",\"date\":\"{EVENT.RECOVERY.DATE}\"}},\"service\":{\"name\":\"{SERVICE.NAME}\",\"description\":\"{SERVICE.DESCRIPTION}\",\"rootcause\":\"{SERVICE.ROOTCAUSE}\"}}"}, {"event_source": "SERVICE", "operation_mode": "RECOVERY", "subject": "Service \"{SERVICE.NAME}\" resolved in {EVENT.DURATION}: {EVENT.NAME}", "message": "{\"type\":\"service_recovery\",\"event\":{\"id\":\"{EVENT.ID}\",\"name\":\"{EVENT.NAME}\",\"severity\":\"{EVENT.SEVERITY}\",\"duration\":\"{EVENT.DURATION}\",\"recovery\":{\"time\":\"{EVENT.RECOVERY.TIME}\",\"date\":\"{EVENT.RECOVERY.DATE}\"}},\"service\":{\"name\":\"{SERVICE.NAME}\",\"description\":\"{SERVICE.DESCRIPTION}\"}}"}, {"event_source": "SERVICE", "operation_mode": "UPDATE", "subject": "Changed \"{SERVICE.NAME}\" service status to {EVENT.UPDATE.SEVERITY} in {EVENT.AGE}", "message": "{\"type\":\"service_update\",\"event\":{\"id\":\"{EVENT.ID}\",\"name\":\"{EVENT.NAME}\",\"status\":\"{EVENT.STATUS}\",\"update\":{\"severity\":\"{EVENT.UPDATE.SEVERITY}\",\"date\":\"{EVENT.UPDATE.DATE}\",\"time\":\"{EVENT.UPDATE.TIME}\"},\"age\":\"{EVENT.AGE}\"},\"service\":{\"name\":\"{SERVICE.NAME}\",\"description\":\"{SERVICE.DESCRIPTION}\",\"rootcause\":\"{SERVICE.ROOTCAUSE}\"}}"}]}]}}